# Biz-DNA API 환경변수 예시. 이 파일을 api/.env로 복사해 값을 채운다.
# api/.env는 git에 올라가지 않는다. 실제 키·비밀번호는 .env에만 적는다.

# 실행 환경: development | production (production이면 API 문서 페이지를 끈다)
BIZDNA_ENV=development

# 브라우저에서 API를 직접 호출할 수 있는 웹 주소(쉼표로 구분). 배포 시 실제 도메인으로 바꾼다.
BIZDNA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# /docs, /openapi.json 노출 여부. 비워 두면 development=true, production=false
BIZDNA_API_DOCS=

# PDF 한글 폰트(TTF) 경로. 비워 두면 맑은 고딕(Windows) → 나눔(Linux) 순으로 찾는다.
BIZDNA_FONT_REGULAR=
BIZDNA_FONT_BOLD=

# ---- 아래는 아직 쓰지 않는다(향후 기능용 자리) ----
# AI 서술 보고서(FR-20). 공급자는 미정. 키는 절대 웹(web/) 쪽 변수에 넣지 않는다.
BIZDNA_AI_PROVIDER=
BIZDNA_AI_MODEL=
BIZDNA_AI_API_KEY=

# 데이터베이스(FR-12). 예: postgresql+psycopg://user:password@host:5432/bizdna
DATABASE_URL=

# 로그인 세션·토큰 서명 키(FR-01). 긴 무작위 문자열.
BIZDNA_AUTH_SECRET=
