# Biz-DNA API 환경변수 예시. 이 파일을 api/.env로 복사해 값을 채운다.
# api/.env는 git에 올라가지 않는다. 실제 키·비밀번호는 .env에만 적는다.

# 실행 환경: development | production (production이면 API 문서 페이지를 끈다)
BIZDNA_ENV=development

# 브라우저에서 API를 직접 호출할 수 있는 웹 주소(쉼표로 구분). 배포 시 실제 도메인으로 바꾼다.
BIZDNA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# /docs, /openapi.json 노출 여부. 비워 두면 development=true, production=false
BIZDNA_API_DOCS=

# PDF 한글 폰트(TTF) 경로. 비워 두면 맑은 고딕(Windows) → 나눔(Linux) 순으로 찾는다.
BIZDNA_FONT_REGULAR=
BIZDNA_FONT_BOLD=

# ---- 아래는 아직 쓰지 않는다(향후 기능용 자리) ----
# AI 서술 보고서(FR-20). 공급자는 미정. 키는 절대 웹(web/) 쪽 변수에 넣지 않는다.
BIZDNA_AI_PROVIDER=
BIZDNA_AI_MODEL=
BIZDNA_AI_API_KEY=

# ---- Supabase (FR-01 로그인, FR-12 진단 저장) ----
# Vercel의 Supabase 연동이 자동 등록한다. 로컬은 `npx vercel env pull api/.env` 로 받는다.
# 비워 두면 회원 API가 503을 돌려주고 게스트 진단만 동작한다. 이 값들은 api 쪽에서만 쓴다.
SUPABASE_URL=
# 관리자 키. 회원가입(이메일 인증 없이 확인 완료 계정 생성)에 쓴다. 절대 web/ 쪽에 두지 않는다.
SUPABASE_SECRET_KEY=
# 구형(HS256) 프로젝트만 필요. 새 프로젝트는 JWKS(비대칭 키)로 검증하므로 비워 둔다.
SUPABASE_JWT_SECRET=
# FastAPI가 쓰는 풀링 연결(트랜잭션 풀러)
POSTGRES_URL=
# 마이그레이션용 직접 연결 (scripts/migrate.py)
POSTGRES_URL_NON_POOLING=
