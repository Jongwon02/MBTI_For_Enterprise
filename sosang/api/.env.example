# 소상공인 API 환경변수 예시. 복사해서 sosang/api/.env로 쓴다(커밋 금지).
# development | production (production이면 /api/sosang/docs를 끈다)
SOSANG_ENV=
# 브라우저에서 API를 직접 호출할 수 있는 웹 주소(쉼표 구분). 비우면 로컬 개발 주소.
SOSANG_CORS_ORIGINS=
SOSANG_API_DOCS=
# PDF 한글 폰트 경로(비우면 동봉한 fonts/ 나눔고딕)
SOSANG_FONT_REGULAR=
SOSANG_FONT_BOLD=
# Supabase(회원가입·로그인·진단 저장). 루트 api/.env와 같은 값을 쓴다. 비우면 게스트 진단만 동작한다.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
POSTGRES_URL=
