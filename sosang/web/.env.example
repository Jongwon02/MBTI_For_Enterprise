# 소상공인 웹 환경변수 예시. sosang/web/.env.local로 복사해 쓴다(커밋 금지).
# 주의: NEXT_PUBLIC_ 변수는 브라우저에 공개된다. 비밀값을 두지 않는다.

# 소상공인 FastAPI 서버 주소(로컬 개발용 rewrites). 빌드할 때 고정된다.
SOSANG_API_URL=http://127.0.0.1:8001

# Supabase 로그인(회원가입·로그인). 브라우저에 공개되어도 되는 값만 둔다(URL과 publishable key).
# 중소경영 web과 같은 값을 쓴다. 비워 두면 회원 기능이 꺼지고 게스트 진단만 동작한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
