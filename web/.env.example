# Biz-DNA 웹 환경변수 예시. 이 파일을 web/.env.local로 복사해 값을 채운다.
# web/.env.local은 git에 올라가지 않는다.
#
# 주의: NEXT_PUBLIC_ 으로 시작하는 변수는 브라우저에 그대로 공개된다.
# 비밀키는 절대 NEXT_PUBLIC_ 변수나 web/ 쪽에 두지 말고 api/.env에 둔다.

# FastAPI 서버 주소. /api/* 요청을 이 주소로 넘긴다(서버에서만 쓰이고 브라우저에는 노출되지 않음).
# 빌드할 때 값이 고정되므로 바꾸면 다시 빌드한다.
BIZDNA_API_URL=http://127.0.0.1:8000

# 소상공인 앱(sosang/run_dev.bat, 웹 3001 + API 8001) 주소. 로컬에서 /sosang/*, /api/sosang/*를 넘긴다(Vercel에서는 쓰지 않음).
SOSANG_WEB_URL=http://127.0.0.1:3001
SOSANG_API_URL=http://127.0.0.1:8001

# Supabase 로그인(FR-01). 브라우저에 공개되어도 되는 값만 둔다(URL과 publishable key).
# Vercel의 Supabase 연동이 자동 등록한다. 비워 두면 로그인·회원가입이 꺼지고 게스트 진단만 동작한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
